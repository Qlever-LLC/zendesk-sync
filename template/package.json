{
  "private": true,
  "version": "0.3.0",
  "description": "SvelteKit based template for Zendesk tickets",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node22": "^22.0.5",
    "autoprefixer": "^10.5.4",
    "daisyui": "^5.7.9",
    "date-fns": "^4.4.0",
    "postcss": "^8.5.25",
    "pretty-bytes": "^7.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "volta": {
    "node": "22.6.0"
  },
  "dependenciesMeta": {
    "@sveltejs/vite-plugin-svelte@3.1.2": {
      "unplugged": true
    }
  }
